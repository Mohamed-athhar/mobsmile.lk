# Copy to .env for local development (never commit .env).
# On Vercel, add these under Project -> Settings -> Environment Variables.

# --- Supabase (public values, safe in the browser) ---
# Supabase Dashboard -> Project Settings -> API (or the "Connect" button)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server-only (OPTIONAL) ---
# Only needed by the staff-management server functions in
# src/lib/admin.functions.ts. NEVER prefix with VITE_ and never expose it.
# SUPABASE_SERVICE_ROLE_KEY=

# NOTE: AI provider keys do NOT go here. They live in Supabase secrets and are
# used only by the ai-gateway Edge Function (see the backend package).
